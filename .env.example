# Supabase Configuration
VITE_SUPABASE_URL=https://rtdgynwnuxtqidsegjzs.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# --- AI gateway (OpenRouter) — SERVER-SIDE ONLY, never prefix with VITE_ ---
# Local dev: put this in .env.local (git-ignored). Production: `supabase secrets set OPENROUTER_API_KEY=...`
# OPENROUTER_API_KEY=sk-or-v1-...
# Optional model overrides (comma-separated = fallback order). Check openrouter.ai/models for current slugs.
# OPENROUTER_IDEATION_MODEL=google/gemini-3.8-flash
# OPENROUTER_DEVELOP_MODEL=anthropic/claude-opus-5.5
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Google Gemini (project assistant + image fallback) — server-side secret only ---
# supabase secrets set GEMINI_API_KEY=...   (never put it in a VITE_ variable or in chat)
GEMINI_API_KEY=
# optional: more keys of the SAME Google account/project, comma separated
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DEVELOP_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# openrouter (default) | gemini : which provider writes ideas/manuals first
TEXT_PROVIDER=openrouter
