# Supabase Configuration
VITE_SUPABASE_URL=https://hbllosyoutuautignyop.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# --- AI gateway (OpenRouter) — SERVER-SIDE ONLY, never prefix with VITE_ ---
# Local dev: put this in .env.local (git-ignored). Production: `supabase secrets set OPENROUTER_API_KEY=...`
# OPENROUTER_API_KEY=sk-or-v1-...
# Optional model overrides (comma-separated = fallback order). Check openrouter.ai/models for current slugs.
# OPENROUTER_IDEATION_MODEL=google/gemini-3.8-flash
# OPENROUTER_DEVELOP_MODEL=anthropic/claude-opus-5.5
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image,gemini-2.5-flash-image

# --- Google Gemini (project assistant + image fallback) — server-side secret only ---
# supabase secrets set GEMINI_API_KEY=...   (never put it in a VITE_ variable or in chat)
GEMINI_API_KEY=
# optional: more keys of the SAME Google account/project, comma separated
GEMINI_API_KEYS=
# Optional dedicated key for IMAGES only (can belong to another Google account/project)
GEMINI_IMAGE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DEVELOP_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image,gemini-2.5-flash-image
# openrouter (default) | gemini : which provider writes ideas/manuals first
TEXT_PROVIDER=openrouter

# --- Cost control (server secrets) ---
# Projects produced per generation (1 = cheapest, max 3)
MAX_PROJECTS=1
# Platform-wide budget per rolling 24h, shared by everyone (the admin is exempt)
GLOBAL_DAILY_PROJECTS=10
GLOBAL_DAILY_IMAGES=40
GLOBAL_DAILY_CHATS=150
# Per-person daily caps
DAILY_GENERATIONS=2
DAILY_PROJECTS=2
DAILY_IMAGES=12
DAILY_CHATS=20

# Paid model for the 2x2 stage-guide sheets ("إنشاء صور المراحل"): exact slug from openrouter.ai/models (output: image)
OPENROUTER_GUIDE_IMAGE_MODEL=

# Cloudflare Workers AI (GPT Image 2.5 Sunburst) for the stage sheets: set as Supabase secrets, never in chat
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_QUALITY=medium   # low | medium | high | xhigh | max
